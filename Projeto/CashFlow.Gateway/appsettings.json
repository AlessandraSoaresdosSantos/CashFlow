{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "entry-route": {
        "ClusterId": "entry-cluster",
        "Match": {
          "Path": "/api/entry/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/entry/{**catch-all}" }
        ]
      },
      "balance-route": {
        "ClusterId": "balance-cluster",
        "Match": {
          "Path": "/api/balance/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/balance/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "entry-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "balance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}